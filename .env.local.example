# ==========================================
# PAMONG AI — Environment Configuration
# ==========================================

# Google Gemini API Configuration (Recommended)
# Dapatkan API Key di: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI Configuration (Opsional / Alternatif)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Auth Configuration
JWT_SECRET=pamong-ai-secret-key-development-2026-super-secure-token

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed Guru (Akun Demo Otomatis)
SEED_TEACHER_EMAIL=guru@pamong-ai.id
SEED_TEACHER_PASSWORD=demo1234
SEED_TEACHER_NAME=Ibu Sari
